{
  "expo": {
    "name": "Go Champs",
    "slug": "go-champs-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAFAEE",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.gochamps.app",
      "appleTeamId": "H859MRQ6UP",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gochamps.app",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#1D1D1B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Go Champs",
      "shortName": "Go Champs",
      "themeColor": "#10130D",
      "backgroundColor": "#FAFAEE",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-white-name.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#1d1d1b",
          "dark": {
            "image": "./assets/images/logo-white-name.png",
            "backgroundColor": "#1d1d1b"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às suas fotos para escolher a foto do seu perfil de atleta.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Permita o acesso às suas fotos para escolher a foto do seu perfil de atleta.",
          "savePhotosPermission": "Permita salvar nas suas fotos as imagens do seu perfil de atleta.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "07a87e62-c99e-4ceb-b2c4-0ff27a5544d5"
      }
    },
    "owner": "wagnerassis"
  }
}
