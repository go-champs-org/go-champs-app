{
  "expo": {
    "name": "go-champs-app",
    "slug": "go-champs-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAEE",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.gochamps.app",
      "appleTeamId": "H859MRQ6UP",
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#1D1D1B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Go Champs",
      "shortName": "Go Champs",
      "themeColor": "#10130D",
      "backgroundColor": "#FAFAEE",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "07a87e62-c99e-4ceb-b2c4-0ff27a5544d5"
      }
    },
    "owner": "wagnerassis"
  }
}
