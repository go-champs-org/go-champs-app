{
  "name": "go-champs-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npm run e2e:build && playwright test",
    "e2e:build": "expo export --platform web --output-dir .e2e-dist",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:coverage",
    "check:fingerprint": "node -e \"require('@expo/fingerprint').createFingerprintAsync(process.cwd(), { platforms: ['ios'] }).then(result => console.log(result.hash)).catch(error => { console.error(error); process.exit(1); })\"",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/core/**/*.ts",
      "src/data/**/*.ts",
      "src/domain/**/*.ts",
      "src/viewmodels/**/*.ts",
      "!src/models/**",
      "!src/navigation/types.ts",
      "!src/data/dto/**",
      "!src/domain/repositories/**",
      "!src/core/http/HttpClient.ts",
      "!src/core/auth/AuthTokenStore.ts",
      "!src/core/auth/TokenProvider.ts",
      "!src/**/__tests__/**",
      "!src/test/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@react-navigation/stack": "^7.1.1",
    "expo": "^58.0.5",
    "expo-blur": "~58.0.3",
    "expo-constants": "~58.0.10",
    "expo-font": "~58.0.7",
    "expo-haptics": "~58.0.5",
    "expo-linking": "~58.0.11",
    "expo-router": "~58.0.15",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.6",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.5",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.63.0",
    "@react-native/jest-preset": "^0.87.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^29.2.1",
    "jest-expo": "~58.0.7",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@babel/helpers": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@tootallnate/once": "^2.0.1",
    "@xmldom/xmldom": "^0.8.13",
    "decode-uri-component": "^0.5.0",
    "form-data": "^4.0.5",
    "@expo/cli": {
      "glob": "^10.5.0"
    },
    "@expo/config": {
      "glob": "^10.5.0"
    },
    "@expo/config-plugins": {
      "glob": "^10.5.0"
    },
    "@expo/devcert": {
      "glob": "^10.5.0"
    },
    "@expo/fingerprint": {
      "glob": "^10.5.0"
    },
    "@expo/metro-config": {
      "glob": "^10.5.0"
    },
    "expo-modules-autolinking": {
      "glob": "^10.5.0"
    },
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.24",
    "node-forge": "^1.4.0",
    "picomatch": "^4.0.3",
    "postcss": "^8.5.15",
    "react-server-dom-webpack": "19.1.7",
    "sucrase": {
      "glob": "^10.5.0"
    },
    "tar": "^7.5.10",
    "undici": "^6.24.0",
    "uuid": "^11.1.1",
    "ws": "^8.20.1",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
