{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": [
        "./*"
      ],
      // Its package points TypeScript at the raw sources for the react-native
      // condition, which do not type-check against this React Native.
      "react-native-view-shot": ["./node_modules/react-native-view-shot/lib/index.d.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
